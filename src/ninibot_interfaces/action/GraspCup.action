# Goal
# timeout_sec <= 0 uses the server default timeout.
float32 timeout_sec
# If true, a goal sent after grasp_cup_node already reports FINISHED succeeds immediately.
bool succeed_on_existing_finished
---
# Result
bool success
string final_status
string failure_reason
float32 elapsed_sec
---
# Feedback
string status
string debug
float32 elapsed_sec
float32 error_x
float32 bbox_w
float32 bbox_error
